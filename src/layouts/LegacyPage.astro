---
interface Props {
  source: string;
}

const { source } = Astro.props;
const head = source.match(/<head>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const bodyTag = source.match(/<body([^>]*)>/i)?.[1] ?? '';
const body = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
const bodyClass = bodyTag.match(/class=["']([^"']*)["']/i)?.[1];
const menuMode = bodyTag.match(/data-menu-mode=["']([^"']*)["']/i)?.[1];
const cleanHead = head.replace(/<link\s+rel=["']stylesheet["'][^>]*>/gi, '');
---
<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={cleanHead} />
    <meta name="apple-itunes-app" content="app-id=6769843722" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/enhancements.css" />
    <link rel="stylesheet" href="/polish.css" />
    <link rel="stylesheet" href="/map-polish.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={bodyClass} data-menu-mode={menuMode}>
    <aside class="mobile-app-banner" id="mobileAppBanner" aria-label="Get the Bellissimo app" hidden>
      <button class="mobile-app-banner__close" type="button" aria-label="Dismiss app banner">&times;</button>
      <img src="/assets/images/bellissimo-logo.webp" alt="" width="52" height="52" />
      <div class="mobile-app-banner__copy">
        <strong>Bellissimo Pizzeria &amp; Pasta</strong>
        <span id="mobileAppBannerMessage">Order faster with our app</span>
      </div>
      <a id="mobileAppBannerLink" href="https://play.google.com/store/apps/details?id=com.avco.bellissimo">Get the app</a>
    </aside>
    <Fragment set:html={body} />
    <script is:inline>
      (() => {
        const banner = document.getElementById('mobileAppBanner');
        const link = document.getElementById('mobileAppBannerLink');
        const message = document.getElementById('mobileAppBannerMessage');
        const userAgent = navigator.userAgent;
        const isAndroid = /Android/i.test(userAgent);
        const isIOS = /iPhone|iPad|iPod/i.test(userAgent)
          || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const isIOSSafari = isIOS
          && /Safari/i.test(userAgent)
          && !/CriOS|FxiOS|EdgiOS|OPiOS|DuckDuckGo/i.test(userAgent);
        const isMobileViewport = window.matchMedia('(max-width: 900px)').matches;

        // iOS Safari renders the native banner from apple-itunes-app.
        if (!banner || !link || !message || !isMobileViewport || isIOSSafari || (!isAndroid && !isIOS)) return;

        const platform = isAndroid ? 'Android' : 'iOS';
        const dismissalKey = `bellissimo${platform}BannerDismissedUntil`;
        if (isIOS) {
          link.href = 'https://apps.apple.com/us/app/bellissimo-pizzeria-pasta/id6769843722';
          message.textContent = 'Order faster with our iPhone app';
        } else {
          message.textContent = 'Order faster with our Android app';
        }

        let dismissedUntil = 0;
        try {
          dismissedUntil = Number(localStorage.getItem(dismissalKey) || 0);
        } catch {}
        if (Date.now() < dismissedUntil) return;

        banner.hidden = false;
        banner.querySelector('button')?.addEventListener('click', () => {
          banner.hidden = true;
          try {
            localStorage.setItem(
              dismissalKey,
              String(Date.now() + 7 * 24 * 60 * 60 * 1000),
            );
          } catch {}
        });
      })();
    </script>
  </body>
</html>
